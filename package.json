{
  "name": "knowledge-garden-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "course:prepare": "node scripts/prepare-course-for-nexus.mjs",
    "notes:validate": "node scripts/validate-obsidian-notes.mjs",
    "notes:draft": "node scripts/generate-lesson-note-drafts.mjs",
    "courses:inventory": "node scripts/inventory-course-library.mjs",
    "courses:intake": "node scripts/batch-course-intake.mjs --apply",
    "course:stage": "node scripts/stage-polished-course-assets.mjs",
    "course:complete-fengshui": "node scripts/complete-fengshui-course-notes.mjs",
    "course:pipeline": "node scripts/run-course-knowledge-pipeline.mjs",
    "course:193:pipeline": "node scripts/run-course-knowledge-pipeline.mjs --course '193｜（墨夏班）AI影片創作0-1實戰營'",
    "search:rebuild": "node scripts/sync-transcripts-to-firestore.mjs --notes-only",
    "sync:service": "node scripts/nexus-background-service.mjs",
    "vtt:polish-pilot": "node scripts/polish-vtt-pilot.mjs",
    "course:import-bazi": "node scripts/import-bazi-course-batch.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
